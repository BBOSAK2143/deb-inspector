#!/usr/bin/python3
import re
import os
import sys, threading
import subprocess
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, Pango

class DebInspector(Gtk.Window):
    def __init__(self):
        super().__init__(title="Deb Package Installer — Prototype")
        self.set_border_width(14)
        self.set_default_size(760, 620)
        self.selected_path = None
        self.details_text = ""
        self.preview_text = ""
        if getattr(self, "install_button", None): self.install_button.set_sensitive(False)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(outer)

        intro = Gtk.Label(
            label="Inspect a .deb and preview APT's plan. This prototype does not install anything."
        )
        intro.set_xalign(0)
        intro.set_line_wrap(True)
        outer.pack_start(intro, False, False, 0)

        controls = Gtk.Box(spacing=8)
        outer.pack_start(controls, False, False, 0)

        choose_button = Gtk.Button(label="Choose .deb file…")
        choose_button.connect("clicked", self.choose_file)
        controls.pack_start(choose_button, False, False, 0)

        self.preview_button = Gtk.Button(label="Preview install")
        self.preview_button.set_sensitive(False)
        self.preview_button.connect("clicked", self.preview_install)
        controls.pack_start(self.preview_button, False, False, 0)
        self.install_button = Gtk.Button(label="Install")
        self.install_button.set_sensitive(False)
        self.install_button.connect("clicked", self.confirm_install)
        controls.pack_start(self.install_button, False, False, 0)

        self.copy_button = Gtk.Button(label="Copy details")
        self.copy_button.set_sensitive(False)
        self.copy_button.connect("clicked", self.copy_details)
        controls.pack_start(self.copy_button, False, False, 0)

        package_scroll = Gtk.ScrolledWindow()
        package_scroll.set_policy(
            Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC
        )
        package_scroll.set_min_content_height(190)
        outer.pack_start(package_scroll, True, True, 0)

        self.grid = Gtk.Grid()
        self.grid.set_column_spacing(16)
        self.grid.set_row_spacing(8)
        self.grid.set_border_width(8)
        self.grid.set_hexpand(True)
        package_scroll.add(self.grid)
        self.show_message("No package selected.")

        preview_label = Gtk.Label(label="APT output:")
        preview_label.set_xalign(0)
        outer.pack_start(preview_label, False, False, 0)

        preview_scroll = Gtk.ScrolledWindow()
        preview_scroll.set_policy(
            Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC
        )
        preview_scroll.set_min_content_height(180)
        outer.pack_start(preview_scroll, True, True, 0)

        self.preview_view = Gtk.TextView()
        self.preview_view.set_editable(False)
        self.preview_view.set_cursor_visible(False)
        self.preview_view.set_monospace(True)
        self.preview_view.set_wrap_mode(Gtk.WrapMode.NONE)
        self.preview_view.get_buffer().set_text(
            "Choose a .deb file, then click “Preview install”."
        )
        preview_scroll.add(self.preview_view)

    def show_message(self, message):
        for child in self.grid.get_children():
            self.grid.remove(child)
        label = Gtk.Label(label=message)
        label.set_xalign(0)
        label.set_line_wrap(True)
        label.set_selectable(True)
        self.grid.attach(label, 0, 0, 2, 1)
        self.grid.show_all()

    def choose_file(self, _button):
        dialog = Gtk.FileChooserDialog(
            title="Select a Debian package",
            parent=self,
            action=Gtk.FileChooserAction.OPEN,
        )
        dialog.add_buttons(
            "Cancel", Gtk.ResponseType.CANCEL,
            "Open", Gtk.ResponseType.ACCEPT,
        )

        if dialog.run() == Gtk.ResponseType.ACCEPT:
            self.inspect_file(dialog.get_filename())

        dialog.destroy()

    def inspect_file(self, path):
        fields = ["Package", "Version", "Architecture", "Maintainer", "Depends"]
        values = []

        for field in fields:
            result = subprocess.run(
                ["dpkg-deb", "-f", path, field],
                capture_output=True, text=True
            )
            value = result.stdout.strip() or "(not specified)"
            values.append((field, value))

        self.selected_path = path
        self.preview_text = ""
        if getattr(self, "install_button", None): self.install_button.set_sensitive(False)
        self.preview_view.get_buffer().set_text(
            "Click “Preview install” to ask APT what it would do.\n"
            "This is a simulation; it makes no package changes."
        )

        self.details_text = "File: " + path + "\n" + "\n".join(
            f"{field}: {value}" for field, value in values
        )

        for child in self.grid.get_children():
            self.grid.remove(child)

        for row, (name, value) in enumerate([("File", path)] + values):
            name_label = Gtk.Label(label=name + ":")
            name_label.set_xalign(0)
            name_label.set_valign(Gtk.Align.START)

            value_label = Gtk.Label(label=value)
            value_label.set_xalign(0)
            value_label.set_valign(Gtk.Align.START)
            value_label.set_line_wrap(True)
            value_label.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            value_label.set_selectable(True)
            value_label.set_max_width_chars(70)
            value_label.set_hexpand(True)

            self.grid.attach(name_label, 0, row, 1, 1)
            self.grid.attach(value_label, 1, row, 1, 1)

        self.preview_button.set_sensitive(True)
        m = re.search(r"(\d+)\s+upgraded,\s+(\d+)\s+newly installed,\s+(\d+)\s+to remove", self.preview_text)
        can_inst = ("Simulation exit status: 0" in self.preview_text and (not m or int(m[3]) == 0))
        self.install_button.set_sensitive(bool(can_inst))
        self.copy_button.set_sensitive(True)
        self.grid.show_all()

    def preview_install(self, _button):
        if not self.selected_path:
            return

        self.preview_button.set_sensitive(False)
        self.preview_view.get_buffer().set_text(
            "Running APT simulation… no packages will be changed."
        )
        while Gtk.events_pending():
            Gtk.main_iteration()

        try:
            result = subprocess.run(
                ["apt-get", "--simulate", "install", self.selected_path],
                capture_output=True,
                text=True,
                timeout=90
            )
            self.preview_text = (
                f"Simulation exit status: {result.returncode}\n\n"
                + result.stdout
                + ("\n" + result.stderr if result.stderr else "")
            )
        except subprocess.TimeoutExpired:
            self.preview_text = "APT simulation timed out. No packages were installed."
        except Exception as error:
            self.preview_text = f"Could not run APT simulation: {error}"

        self.preview_view.get_buffer().set_text(self.preview_text)
        self.preview_button.set_sensitive(True)
        m = re.search(r"(\d+)\s+upgraded,\s+(\d+)\s+newly installed,\s+(\d+)\s+to remove", self.preview_text)
        can_inst = ("Simulation exit status: 0" in self.preview_text and (not m or int(m[3]) == 0))
        self.install_button.set_sensitive(bool(can_inst))


    def copy_details(self, _button):
        text = self.details_text
        if self.preview_text:
            text += "\n\nAPT output:\n" + self.preview_text

        clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clipboard.set_text(text, -1)
        clipboard.store()

        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK,
            text="Package details copied",
        )
        dialog.format_secondary_text(
            "You can now paste them into a message or text editor."
        )
        dialog.run()
        dialog.destroy()


    def confirm_install(self, _button):
        if not self.selected_path: return
        d = Gtk.MessageDialog(transient_for=self, modal=True,
            message_type=Gtk.MessageType.WARNING, buttons=Gtk.ButtonsType.CANCEL,
            text="Install this package?")
        d.add_button("Install", Gtk.ResponseType.YES)
        d.format_secondary_text("APT will install this package and required dependencies, refusing to remove existing packages.")
        resp = d.run(); d.destroy()
        if resp == Gtk.ResponseType.YES:
            self.preview_button.set_sensitive(False)
            self.install_button.set_sensitive(False)
            self.preview_view.get_buffer().set_text("Authenticating and installing via APT...")
            while Gtk.events_pending(): Gtk.main_iteration()
            try:
                r = subprocess.run(["/usr/bin/pkexec", "/usr/bin/apt-get", "install", "-y", "--no-remove", self.selected_path], capture_output=True, text=True, timeout=300)
                msg = ("Installation succeeded!\n\n" if r.returncode == 0 else f"Install exited with {r.returncode}\n\n") + r.stdout + r.stderr
            except Exception as e:
                msg = f"Installer error: {e}"
        self.preview_text = msg
        self.preview_view.get_buffer().set_text(msg)
        self.preview_button.set_sensitive(True)

from gi.repository import GLib
from urllib.parse import unquote, urlparse
window = DebInspector()
window.connect("destroy", Gtk.main_quit)
window.show_all()
if len(sys.argv[1]) > 1:
    arg = unquote(urlparse(sys.argv[1]).path) if sys.argv[1].startswith("file://") else sys.argv[1]
    if os.path.isfile(arg):
        GLib.idle_add(window.inspect_file, arg)
Gtk.main()
